{
  "$comment": "Stack rules. TEdit's maxStackSize is 9999 for almost every item, so these decide. Single (max 1): armor, accessories, mounts and mapped weapons, from item flags and weapon-classes.json. Coins have fixed limits (platinum 9999 is confirmed by real saves). Clearly stackable and safe stackable items go up to 9999 with no warning; anything else up to 9999 with a warning.",
  "maxStack": 9999,
  "coins": {
    "CopperCoin": 100,
    "SilverCoin": 100,
    "GoldCoin": 100,
    "PlatinumCoin": 9999
  },
